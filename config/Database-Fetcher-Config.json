{
  "globalStartDate": "1999-12-01",
  "globalConcurrency": 5,
  "templates": {
    "fred_series": {
      "provider": "FRED",
      "endpoint": "/fred/series/observations",
      "params": {
        "file_type": "json"
      }
    },
    "tiingo_daily": {
      "provider": "Tiingo",
      "endpoint": "/tiingo/daily/{ticker}/prices",
      "params": {},
      "resolution": "daily"
    }
  },
  "providers": {
    "Binance": {
      "type": "http",
      "baseUrl": "https://api.binance.us",
      "overrideStartDate": "2017-08-01",
      "auth": null,
      "requestsPerSecond": 2,
      "maxRetries": 3,
      "pagination": {
        "strategy": "time-cursor",
        "limitParam": "limit",
        "maxLimit": 1000,
        "startParam": "startTime",
        "endParam": "endTime",
        "cursorExtractPath": "last_item_index_6",
        "cursorModifier": "add_1ms",
        "dateExtractPath": 0,
        "dateFormat": "unix-ms"
      }
    },
    "FiscalData": {
      "type": "http",
      "baseUrl": "https://api.fiscaldata.treasury.gov/services/api/fiscal_service",
      "auth": null,
      "responseExtractPath": "data",
      "pagination": {
        "strategy": "page-number",
        "limitParam": "page[size]",
        "maxLimit": 10000,
        "pageParam": "page[number]",
        "startPage": 1,
        "incrementalFilterParam": "filter",
        "incrementalFilterTemplate": "record_date:gte:{date}",
        "dateExtractPath": "record_date",
        "dateFormat": "YYYY-MM-DD"
      }
    },
    "FRED": {
      "type": "http",
      "baseUrl": "https://api.stlouisfed.org",
      "auth": {
        "type": "query",
        "key": "api_key",
        "envVar": "FRED_API_KEY"
      },
      "responseExtractPath": "observations",
      "pagination": {
        "strategy": "date-range",
        "limitParam": "limit",
        "maxLimit": 100000,
        "startParam": "observation_start",
        "endParam": "observation_end",
        "dateExtractPath": "date",
        "dateFormat": "YYYY-MM-DD"
      }
    },
    "Tiingo": {
      "type": "http",
      "baseUrl": "https://api.tiingo.com",
      "concurrency": 1,
      "requestsPerSecond": 0.8,
      "auth": {
        "type": "header",
        "key": "Authorization",
        "prefix": "Token ",
        "envVar": "TIINGO_API_KEY"
      },
      "pagination": {
        "strategy": "date-range",
        "startParam": "startDate",
        "endParam": "endDate",
        "dateExtractPath": "date",
        "dateFormat": "YYYY-MM-DD"
      }
    },
    "YahooFinance": {
      "type": "package",
      "pagination": {
        "strategy": "package-internal",
        "startParam": "period1",
        "dateExtractPath": "date",
        "dateFormat": "YYYY-MM-DD"
      },
      "responseExtractPath": "quotes"
    },
    "SecEdgar": {
      "type": "http",
      "baseUrl": "https://data.sec.gov/api/xbrl",
      "auth": null,
      "headers": {
        "User-Agent": "CrashRadar/1.0 (research@example.com)"
      }
    },
    "Cboe": {
      "type": "package",
      "pagination": {
        "strategy": "custom",
        "dateExtractPath": "record_date",
        "dateFormat": "YYYY-MM-DD"
      }
    },
    "Finra": {
      "type": "package",
      "overrideStartDate": "2023-01-01",
      "requestsPerSecond": 2,
      "pagination": {
        "strategy": "custom",
        "dateExtractPath": "record_date",
        "dateFormat": "YYYY-MM-DD"
      }
    },
    "SqueezeMetrics": {
      "type": "package",
      "overrideStartDate": "2011-05-02",
      "pagination": {
        "strategy": "custom",
        "dateExtractPath": "date",
        "dateFormat": "YYYY-MM-DD"
      }
    },
    "AAII": {
      "type": "package",
      "pagination": {
        "strategy": "custom",
        "dateExtractPath": "record_date",
        "dateFormat": "YYYY-MM-DD"
      }
    },
    "NAAIM": {
      "type": "package",
      "pagination": {
        "strategy": "custom",
        "dateExtractPath": "record_date",
        "dateFormat": "YYYY-MM-DD"
      }
    },
    "Calendar": {
      "type": "package",
      "pagination": {
        "strategy": "custom",
        "dateExtractPath": "event_date",
        "dateFormat": "YYYY-MM-DD"
      }
    },
    "SecEdgar13F": {
      "type": "package",
      "overrideStartDate": "2025-07-01",
      "pagination": {
        "strategy": "custom",
        "dateExtractPath": "report_date",
        "dateFormat": "YYYY-MM-DD"
      }
    },
    "PolygonM5": {
      "type": "package",
      "baseUrl": "https://api.polygon.io/v2",
      "overrideStartDate": "2024-01-01",
      "concurrency": 1,
      "requestsPerSecond": 0.08,
      "maxRetries": 3,
      "auth": {
        "type": "header",
        "key": "Authorization",
        "prefix": "Bearer ",
        "envVar": "POLYGONIO_API_KEY"
      }
    }
  },
